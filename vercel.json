{
  "version": 2,
  "functions": {
    "src/index.js": {
      "maxDuration": 60,
      "includeFiles": "data/eng.traineddata*"
    }
  },
  "builds": [
    {
      "src": "src/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/src/index.js"
    }
  ]
}
